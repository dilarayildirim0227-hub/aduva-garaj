{
  "name": "aduva-garaj",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "postinstall": "pnpm --filter @aduva/shared build",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @aduva/api prisma:migrate",
    "db:seed": "pnpm --filter @aduva/api prisma:seed",
    "db:studio": "pnpm --filter @aduva/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
