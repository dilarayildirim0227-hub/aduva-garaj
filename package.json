{
  "name": "aduva-garaj",
  "version": "1.0.0",
  "private": true,
  "description": "ADUVA GARAJ - Oto Aksesuar, Multimedya & OEM Yedek Parça E-ticaret",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn main:app --reload --port 8000",
    "dev:frontend": "node server.js",
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild public/js/main.js --bundle --outfile=public/js/main.min.js --minify --target=es2022",
    "build:css": "lightningcss --bundle public/css/base.css --outfile=public/css/base.min.css --minify --target=chrome 100",
    "seed": "cd backend && python -m seed",
    "install:all": "pip install -r backend/requirements.txt && npm install"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.0",
    "lightningcss-cli": "^1.21.0"
  }
}
