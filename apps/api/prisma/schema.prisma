// ============================================================================
// ADUVA GARAJ - ÜRETİM KALİTESİNDE TAM KAPSAMLI PRISMA ŞEMASI (A1 - A12)
// Pazar: Türkiye (KVKK, TRY Kuruş Integer, %20 KDV, e-Fatura/Mesafeli Satış)
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// 1. KULLANICI, OTURUM, ADRES VE KVKK RIZA TABLOLARI (A1, A8)
// ----------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model User {
  id            String        @id @default(uuid())
  phone         String?       @unique
  email         String?       @unique
  passwordHash  String?       // Argon2id hash (A8)
  name          String?
  tcIdentityEnc String?       // e-Arşiv fatura için pgcrypto/AES-256-GCM şifreli TCKN
  role          Role          @default(CUSTOMER)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt     DateTime?     @db.Timestamptz(3) // KVKK anonimlestirme / soft delete
  firstName     String?
  lastName      String?

  sessions      UserSession[]
  consents      UserConsent[]
  vehicles      UserVehicle[]
  addresses     Address[]
  favorites     Favorite[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  appointments  Appointment[]
  notifications Notification[]
  returnReqs    ReturnRequest[]

  @@index([role])
  @@index([deletedAt])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  deviceName       String?
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model UserConsent {
  id            String   @id @default(uuid())
  userId        String
  consentType   String   // KVKK_AYDINLATMA | EXPLICIT_CONSENT | IYS_SMS | IYS_EMAIL
  policyVersion String
  granted       Boolean
  ipAddress     String
  userAgent     String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
}

model Address {
  id          String    @id @default(uuid())
  userId      String
  title       String    // "Ev Adresim", "Sanayi Dükkan"
  fullName    String
  phone       String
  city        String
  district    String
  neighborhood String?
  line        String
  postalCode  String?
  isCorporate Boolean   @default(false)
  companyName String?
  taxOffice   String?
  taxNumber   String?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// 2. ARAÇ HİYERARŞİSİ VE UYUMLULUK MODELİ (A4)
// Marka > Model > Nesil/Kasa > Yıl Aralığı > Motor
// ----------------------------------------------------------------------------

model Vehicle {
  id           String           @id @default(uuid())
  brand        String           // Opel, Volkswagen, Fiat, Renault...
  model        String           // Astra, Golf, Egea, Clio...
  generation   String?          // Astra J (P10), Golf 7 (5G)
  yearFrom     Int
  yearTo       Int?
  body         String?          // Hatchback, Sedan, SUV
  engine       String?          // 1.6 CDTI 136HP, 1.6 TDI 110HP
  ktypeCode    String?          // TecDoc K-Type endüstri referans kodu
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  fitments     ProductFitment[]
  userVehicles UserVehicle[]
  appointments Appointment[]

  @@unique([brand, model, yearFrom, body, engine])
  @@index([brand, model, yearFrom])
  @@index([ktypeCode])
}

model UserVehicle {
  id        String   @id @default(uuid())
  userId    String
  vehicleId String
  nickname  String?
  vinCode   String?  // 17 haneli şasi numarası (opsiyonel)
  isPrimary Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// 3. ÜRÜN KATALOĞU, VARYANT, KATEGORİ VE UYUMLULUK (A1, A2, A3, A4)
// ----------------------------------------------------------------------------

model Category {
  id        String     @id @default(uuid())
  n11Id     String?    @unique
  name      String
  slug      String     @unique
  icon      String?
  parentId  String?
  sortOrder Int        @default(0)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId, sortOrder])
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  PASSIVE
  DRAFT
}

model Product {
  id              String           @id @default(uuid())
  n11Id           String           @unique
  sellerCode      String           @unique
  oemCode         String?
  title           String
  subtitle        String?
  description     String?
  slug            String           @unique
  brand           String?
  price           Decimal          @db.Decimal(12, 2)
  listPrice       Decimal?         @db.Decimal(12, 2)
  priceKurus      Int              @default(0) // Kuruş cinsinden tam sayı (float hatasını önler)
  listPriceKurus  Int?
  lowestPrice30dKurus Int?
  vatRate         Int              @default(20) // %20 KDV
  currency        String           @default("TRY")
  stock           Int              @default(0)
  reservedStock   Int              @default(0)
  maxPerOrder     Int              @default(10)
  status          ProductStatus    @default(ACTIVE)
  categoryId      String?
  n11Url          String?
  isUniversal     Boolean          @default(false)
  isFeatured      Boolean          @default(false)
  isHidden        Boolean          @default(false)
  requiresMontage Boolean          @default(false)
  attributes      Json?            // Esnek teknik özellikler (GIN indeksi ile aranır)
  ratingAvg       Float            @default(0)
  ratingCount     Int              @default(0)
  soldCount       Int              @default(0)
  version         Int              @default(1) // Optimistic locking (A6)
  lastSyncedAt    DateTime         @default(now()) @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?        @db.Timestamptz(3)

  category        Category?        @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  variants        ProductVariant[]
  fitments        ProductFitment[]
  favorites       Favorite[]
  reviews         Review[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  priceHistory    PriceHistory[]
  stockMovements  StockMovement[]

  @@index([status, isHidden, categoryId, priceKurus])
  @@index([isUniversal, status])
  @@index([oemCode])
  @@index([deletedAt])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id          String    @id @default(uuid())
  productId   String
  n11Id       String?
  sku         String?   @unique
  name        String
  attributes  Json
  price       Decimal   @db.Decimal(12, 2)
  priceKurus  Int       @default(0)
  stock       Int       @default(0)
  version     Int       @default(1)
  deletedAt   DateTime? @db.Timestamptz(3)

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([productId])
}

model ProductFitment {
  productId      String
  vehicleId      String
  notes          String?
  verifiedByVin  Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([productId, vehicleId])
  @@index([vehicleId, productId]) // Araçtan ürüne hızlı Index-Only Scan
}

// ----------------------------------------------------------------------------
// 4. SEPET, KUPON VE KAMPANYA TABLOLARI (A1, A6)
// ----------------------------------------------------------------------------

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  token     String?    @unique // Misafir sepeti için httpOnly cookie cartToken (30 gün)
  couponId  String?
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  expiresAt DateTime   @db.Timestamptz(3)

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items     CartItem[]

  @@index([userId])
  @@index([expiresAt])
}

model CartItem {
  id                String          @id @default(uuid())
  cartId            String
  productId         String
  variantId         String?
  vehicleId         String?
  quantity          Int
  unitPriceSnapshot Int             // Sepete eklendiği andaki kuruş fiyatı (priceChanged kontrolü için)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  cart              Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id           String     @id @default(uuid())
  code         String     @unique
  type         CouponType
  value        Int        // PERCENT ise 1..100, FIXED ise kuruş cinsinden tam sayı, FREE_SHIPPING ise 0
  minTotal     Int        @default(0) // Kuruş cinsinden minimum sepet tutarı
  minCartTotal Decimal?   @db.Decimal(12, 2)
  maxUses      Int?
  perUserLimit Int?       @default(1)
  categoryId   String?    // Kategori kısıtlı kuponlar için opsiyonel kategori ID
  usedCount    Int        @default(0)
  startsAt     DateTime?  @db.Timestamptz(3)
  endsAt       DateTime?  @db.Timestamptz(3)
  active       Boolean    @default(true)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  carts        Cart[]
  orders       Order[]

  @@index([code, active])
}

model Campaign {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  ruleJson         Json     // Örn: {"type":"CATEGORY_DISCOUNT","categoryId":"...","percent":15}
  startsAt         DateTime @db.Timestamptz(3)
  endsAt           DateTime @db.Timestamptz(3)
  active           Boolean  @default(true)
  priority         Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([active, startsAt, endsAt])
}

// ----------------------------------------------------------------------------
// 5. SİPARİŞ, ÖDEME, KARGO VE İADE TABLOLARI (A1, A3, A9)
// ----------------------------------------------------------------------------

enum OrderSource {
  APP
  WEB
  N11
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD
  CASH_ON_DELIVERY
  BANK_TRANSFER
}

model Order {
  id                      String               @id @default(uuid())
  orderNumber             String               @unique
  source                  OrderSource          @default(WEB)
  n11OrderId              String?              @unique
  userId                  String?
  couponId                String?
  status                  OrderStatus          @default(PENDING_PAYMENT)
  paymentMethod           PaymentMethod        @default(CARD)
  subtotal                Decimal              @db.Decimal(12, 2)
  shippingFee             Decimal              @default(0) @db.Decimal(12, 2)
  discount                Decimal              @default(0) @db.Decimal(12, 2)
  total                   Decimal              @db.Decimal(12, 2)
  subtotalKurus           Int                  @default(0)
  discountKurus           Int                  @default(0)
  shippingKurus           Int                  @default(0)
  vatTotalKurus           Int                  @default(0)
  grandTotalKurus         Int                  @default(0)
  currency                String               @default("TRY")
  shippingAddress         Json                 // Sipariş anındaki teslimat adresi snapshot
  billingAddress          Json?                // e-Fatura/e-Arşiv vergi/TCKN snapshot
  vehicleSnapshot         Json?                // Sipariş anındaki seçili araç snapshot
  distanceSalesContract   Json?                // Mesafeli satış sözleşmesi onay kaydı (IP, zaman, versiyon)
  carrier                 String?
  trackingCode            String?
  trackingUrl             String?
  paymentRef              String?
  notes                   String?
  createdAt               DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @db.Timestamptz(3)

  user                    User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon                  Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  statusEvents            OrderStatusEvent[]
  payments                PaymentTransaction[]
  shipments               Shipment[]
  returnRequests          ReturnRequest[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                String          @id @default(uuid())
  orderId           String
  productId         String?
  variantId         String?
  title             String          // Ürün adı snapshot
  skuSnapshot       String?
  oemCodeSnapshot   String?
  variantName       String?
  quantity          Int
  unitPrice         Decimal         @db.Decimal(12, 2)
  unitPriceKurus    Int             @default(0)
  vatRateSnapshot   Int             @default(20)
  lineTotalKurus    Int             @default(0)
  imageUrl          String?

  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusEvent {
  id         String      @id @default(uuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String?     // userId veya 'SYSTEM_N11_SYNC'
  note       String?
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model PaymentTransaction {
  id                  String   @id @default(uuid())
  orderId             String
  provider            String   @default("IYZICO") // IYZICO | PAYTR | BANK_TRANSFER
  providerPaymentId   String?  @unique
  conversationId      String   @unique
  amountKurus         Int
  installmentCount    Int      @default(1)
  status              String   // INITIATED | SUCCESS | FAILED | REFUNDED
  maskedCard          String?  // Sadece son 4 hane: "5406 **** **** 1234" (Kart verisi saklanmaz - A8)
  cardAssociation     String?  // MASTER_CARD | VISA | TROY
  rawProviderResponse Json?
  errorMessage        String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Shipment {
  id             String    @id @default(uuid())
  orderId        String
  carrier        String    // "Yurtiçi Kargo", "Aras Kargo"
  trackingNumber String    @unique
  trackingUrl    String?
  status         String    // LABEL_CREATED | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED
  shippedAt      DateTime? @db.Timestamptz(3)
  deliveredAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ReturnRequest {
  id                String   @id @default(uuid())
  orderId           String
  userId            String?
  reason            String   // "Aracımla uyumsuz", "Hasarlı kargo", "Cayma hakkı (14 gün)"
  status            String   @default("REQUESTED") // REQUESTED | APPROVED | REJECTED | REFUNDED
  returnCargoCode   String?
  refundAmountKurus Int      @default(0)
  notes             String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// 6. FAVORİ, YORUM, MONTAJ RANDEVUSU VE BİLDİRİM TABLOLARI (A1)
// ----------------------------------------------------------------------------

model Favorite {
  userId          String
  productId       String
  priceAlertKurus Int?     // Fiyat bu kuruşun altına düşerse push bildirim gönder
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  userId             String
  orderId            String?  // Doğrulanmış satın alım kontrolü
  rating             Int      // 1..5
  comment            String?
  images             Json?
  isVerifiedPurchase Boolean  @default(false)
  approved           Boolean  @default(false)
  helpfulCount       Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, approved, createdAt])
}

model ProductAlert {
  id               String    @id @default(uuid())
  userId           String
  productId        String
  alertType        String    // BACK_IN_STOCK | PRICE_DROP
  targetPriceKurus Int?
  notifiedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([userId, productId, alertType])
  @@index([productId, alertType, notifiedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

model N11StagingProduct {
  id             String   @id @default(uuid())
  n11ProductId   String   @unique
  sellerCode     String
  rawPayload     Json
  payloadHash    String
  syncStatus     String   @default("PENDING") // PENDING | APPLIED | CONFLICT | FAILED
  conflictReason String?
  fetchedAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([sellerCode, syncStatus])
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Appointment {
  id          String            @id @default(uuid())
  userId      String
  vehicleId   String?
  vehicleInfo String?
  serviceType String
  scheduledAt DateTime          @db.Timestamptz(3)
  bayNumber   Int               @default(1) // Garaj montaj istasyonu (Çifte randevu önleme)
  notes       String?
  status      AppointmentStatus @default(REQUESTED)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([bayNumber, scheduledAt])
  @@index([userId, scheduledAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  channel   String    @default("PUSH") // PUSH | SMS | EMAIL
  title     String
  body      String
  dataJson  Json?
  readAt    DateTime? @db.Timestamptz(3)
  sentAt    DateTime  @default(now()) @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ----------------------------------------------------------------------------
// 7. N11 SENKRONİZASYON, DENETİM (AUDIT), STOK/FİYAT GEÇMİŞİ VE AYARLAR (A6-A9)
// ----------------------------------------------------------------------------

model IdempotencyRecord {
  id             String   @id @default(uuid())
  actorScope     String
  idempotencyKey String
  endpoint       String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([actorScope, idempotencyKey])
  @@index([expiresAt])
}

model SyncLog {
  id         String    @id @default(uuid())
  type       String    // PRODUCTS | STOCK_PRICE | ORDERS
  status     String    // RUNNING | SUCCESS | PARTIAL | FAILED
  trigger    String    @default("CRON")
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  total      Int       @default(0)
  created    Int       @default(0)
  updated    Int       @default(0)
  failed     Int       @default(0)
  error      String?

  syncErrors N11SyncError[]

  @@index([type, startedAt])
}

model N11SyncError {
  id               String    @id @default(uuid())
  syncLogId        String
  externalEntityId String
  errorCode        String
  errorMessage     String
  rawPayload       Json?
  retryCount       Int       @default(0)
  nextRetryAt      DateTime? @db.Timestamptz(3)
  resolvedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  syncLog          SyncLog   @relation(fields: [syncLogId], references: [id], onDelete: Cascade)

  @@index([syncLogId])
  @@index([nextRetryAt])
}

model PriceHistory {
  id            String   @id @default(uuid())
  productId     String
  oldPriceKurus Int
  newPriceKurus Int
  source        String   // N11_SYNC | ADMIN_MANUAL | CAMPAIGN
  changedBy     String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model StockMovement {
  id            String   @id @default(uuid())
  productId     String
  delta         Int
  previousStock Int
  newStock      Int
  reason        String   // ORDER_RESERVED | ORDER_CANCELLED | N11_SYNC | RETURN_RESTOCK
  referenceId   String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  String
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Banner {
  id         String  @id @default(uuid())
  title      String
  imageUrl   String
  linkType   String
  linkTarget String?
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
















