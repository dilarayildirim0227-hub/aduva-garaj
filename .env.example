# ---- Genel ----
NODE_ENV=development
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:8081

# ---- Veritabanı / Redis ----
DATABASE_URL=postgresql://aduva:aduva@localhost:5432/aduva?schema=public
REDIS_URL=redis://localhost:6379

# ---- Sepet ve Kargo Ayarları (Kuruş Cinsinden Integer) ----
# 750 TL = 75000 kuruş ücretsiz kargo eşiği
CART_FREE_SHIPPING_KURUS=75000
# 79.90 TL = 7990 kuruş sabit kargo ücreti
CART_SHIPPING_FEE_KURUS=7990
CART_MAX_PER_ORDER_DEFAULT=10
CART_COOKIE_TTL_DAYS=30

# ---- JWT ----
JWT_ACCESS_SECRET=degistir-uzun-rastgele-bir-deger
JWT_REFRESH_SECRET=degistir-baska-uzun-rastgele-bir-deger
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---- n11 Satıcı API ----
# Boş bırakılırsa N11MockClient kullanılır (geliştirme için örnek veri).
N11_APP_KEY=
N11_APP_SECRET=
N11_BASE_URL=https://api.n11.com/ws
N11_SYNC_CRON_MINUTES=15
N11_STORE_URL=https://www.n11.com/magaza/aduvagaraj

# ---- SMS (OTP) ----
SMS_PROVIDER=console   # console | netgsm
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# ---- Sosyal giriş ----
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_ID=com.aduvagaraj.app

# ---- S3 / CDN ----
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=aduva
S3_ACCESS_KEY=aduva
S3_SECRET_KEY=aduva12345
CDN_BASE_URL=http://localhost:9000/aduva

# ---- Ödeme ----
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ---- İzleme ----
SENTRY_DSN=

# ---- Admin seed ----
SEED_ADMIN_EMAIL=admin@aduvagaraj.com
SEED_ADMIN_PASSWORD=Degistir123!
